# 复制本文件为 .env，填入你自己的 MySQL 账号密码。
# .env 已被 .gitignore 排除，不会进版本库。

# ---- 数据库（只给 scripts/prepare_db.py 用来重建测试库）----
MED_DB_HOST=127.0.0.1
MED_DB_PORT=3306
MED_DB_USER=root
MED_DB_PASSWORD=改成你的MySQL密码
# 库名必须包含 _test：prepare_db.py 会 DROP 这个库，名字里带 _test 是最后一道防线。
MED_TEST_DB=medication_api_test

# ---- 被测服务 ----
MED_API_BASE_URL=http://127.0.0.1:8080
